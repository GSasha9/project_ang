{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"],
    "target": "es6",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/app/shared/*"],
      "@state/*": ["src/app/state/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
